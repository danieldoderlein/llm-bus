{
  "name": "@llm-bus/server",
  "version": "2.0.55",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Daniel R. D\u00f6derlein (https://doderlein.com)",
  "homepage": "https://llm-bus.com",
  "description": "LLM Bus - multi-project MCP coordination server: atomic allocation, presence, posts, leases, task graph, queryable ledger.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && cp db/schema.sql dist/db/schema.sql",
    "migrate": "tsx db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "start": "node dist/src/server.js",
    "start:stdio": "node dist/src/stdio.js",
    "dev": "tsx src/server.ts",
    "seed-token": "tsx scripts/seed-token.ts",
    "backfill-handles": "tsx scripts/backfill-handles.ts",
    "backfill-actor-snapshots": "tsx scripts/backfill-actor-snapshots.ts",
    "send-digests": "tsx scripts/send-digests.ts",
    "send-lifecycle": "tsx scripts/send-lifecycle.ts",
    "test:concurrency": "tsx test/concurrency.claim.test.ts",
    "test:smoke": "tsx test/smoke.mcp.test.ts",
    "test:post": "tsx test/post.ack.test.ts",
    "test:lane-delivery": "tsx test/lane.delivery.test.ts",
    "test:onboarding-flow": "tsx test/onboarding.flow.test.ts",
    "test:participant-delete": "tsx test/participant.delete.test.ts",
    "test:multiproject": "tsx test/multiproject.test.ts",
    "test:lease": "tsx test/lease.expiry.test.ts",
    "test:task": "tsx test/task.statemachine.test.ts",
    "test:task-listshape": "tsx test/task.listshape.test.ts",
    "test:isolation": "tsx test/isolation.project.test.ts",
    "test:failopen": "tsx test/hook.failopen.test.ts",
    "test:admin-crud": "tsx test/admin.crud.test.ts",
    "test:admin-isolation": "tsx test/admin.isolation.test.ts",
    "test:admin-authheader": "tsx test/admin.authheader.test.ts",
    "test:invite": "tsx test/invite.redeem.test.ts",
    "test:invite-accept": "tsx test/invite.accept.test.ts",
    "test:oauth": "tsx test/oauth.signup.test.ts",
    "test:consent-preselect": "tsx test/consent.preselect.test.ts",
    "test:attribution": "tsx test/attribution.channel.test.ts",
    "test:identity": "tsx test/identity.handle.test.ts",
    "test:auth-suspension": "tsx test/auth.suspension.test.ts",
    "test:email": "tsx test/email.smtp.test.ts",
    "test:admin-live-propagation": "tsx test/admin.live-propagation.test.ts",
    "test:config": "tsx test/config.validation.test.ts",
    "test:social": "tsx test/social.meta.test.ts",
    "test:activity": "tsx test/activity.panel.test.ts",
    "test:board": "tsx test/board.panel.test.ts",
    "test:board-filter": "tsx test/board.filter.test.ts",
    "test:board-truncation": "tsx test/board.truncation.test.ts",
    "test:oauth-authserver": "tsx test/oauth.authserver.test.ts",
    "test:oauth-http": "tsx test/oauth.http.test.ts",
    "test:connection-status": "tsx test/connection.status.test.ts",
    "test:membership": "tsx test/membership.isolation.test.ts",
    "test:taskwrites": "tsx test/admin.taskwrites.test.ts",
    "test:migration-hardening": "tsx test/migration.hardening.test.ts",
    "test:blockers-accountable": "tsx test/blockers.accountable.test.ts",
    "test:wait-channel": "tsx test/wait.channel.test.ts",
    "test:wait-http": "tsx test/wait.http.test.ts",
    "test:name-collision": "tsx test/admin.namecollision.test.ts",
    "test:member-role": "tsx test/admin.memberrole.test.ts",
    "test:actor-naming": "tsx test/task.actornaming.test.ts",
    "bootstrap-owner": "tsx scripts/bootstrap-owner.ts",
    "verify": "npm run typecheck && npm run test:concurrency && npm run test:smoke && npm run test:post && npm run test:lane-delivery && npm run test:onboarding-flow && npm run test:participant-delete && npm run test:multiproject && npm run test:lease && npm run test:task && npm run test:task-listshape && npm run test:isolation && npm run test:failopen && npm run test:admin-crud && npm run test:admin-isolation && npm run test:admin-authheader && npm run test:invite && npm run test:invite-accept && npm run test:oauth && npm run test:consent-preselect && npm run test:attribution && npm run test:identity && npm run test:auth-suspension && npm run test:email && npm run test:admin-live-propagation && npm run test:config && npm run test:social && npm run test:activity && npm run test:board && npm run test:board-filter && npm run test:board-truncation && npm run test:oauth-authserver && npm run test:oauth-http && npm run test:connection-status && npm run test:membership && npm run test:taskwrites && npm run test:migration-hardening && npm run test:blockers-accountable && npm run test:wait-channel && npm run test:wait-http && npm run test:name-collision && npm run test:member-role && npm run test:actor-naming"
